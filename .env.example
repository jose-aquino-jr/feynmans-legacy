# ---------------------------------------------------------------------------
# Feynman's Legacy API — exemplo de configuração
# Copie para `.env` na raiz do projeto e ajuste conforme o ambiente.
# Todas as variáveis usam o prefixo FL_.
# ---------------------------------------------------------------------------

# Ambiente: development | staging | production | test
FL_ENVIRONMENT=development
FL_LOG_LEVEL=INFO
FL_API_V1_PREFIX=/api/v1

# Diretórios de dados (relativos à raiz do projeto ou absolutos).
FL_DATA_DIR=data/tratados
FL_MODELS_DIR=models

# Paginação de registros.
FL_DEFAULT_LIMIT=100
FL_MAX_LIMIT=1000
FL_MAX_FIELDS=100

# Paginação de grupos em agregações.
FL_AGGREGATION_DEFAULT_LIMIT=1000
FL_AGGREGATION_MAX_LIMIT=10000

# Cache em memória por arquivo (chaveado por caminho + mtime + tamanho).
FL_CACHE_MAX_ENTRIES=32

# CORS: aceita lista JSON ou valores separados por vírgula.
# NUNCA use "*" em produção.
FL_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
FL_CORS_ALLOW_CREDENTIALS=false
